# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=eventphotos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:password@localhost:5432/eventphotos

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Worker Performance Tuning
FACE_WORKER_CONCURRENCY=4
ONNX_INTRA_OP_THREADS=1

# InsightFace Model Configuration
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=640
USE_GPU=false

# Matching Algorithm Thresholds
MATCH_THRESHOLD=0.42
MATCH_REVIEW_FLOOR=0.32
MATCH_MARGIN=0.05

# File & Decompression Protections
MAX_PHOTO_MB=25
MAX_IMAGE_PIXELS=50000000

# Derivative Resolutions
WEB_IMAGE_MAX_EDGE=1600
THUMB_MAX_EDGE=400

# Storage Backend — set to "local" or "r2"
STORAGE_BACKEND=local
STORAGE_ROOT=./backend/uploads

# Cloudflare R2 (only needed when STORAGE_BACKEND=r2)
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=snaptrace-photos
# Optional: public bucket URL for direct browser serving (faster, bypasses backend)
# e.g. https://pub-xxxx.r2.dev  or  https://photos.yourdomain.com
R2_PUBLIC_URL=

# Security & JWT
JWT_SECRET=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
